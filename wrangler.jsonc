{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "42778802-39c3-4c2d-87a1-569c44d6a78f","database_name": "test-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dd49024359ce474e80bc28b907d2657b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
